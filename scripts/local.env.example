# Local release configuration. Copy it: cp scripts/local.env.example scripts/local.env
# scripts/local.env is NOT committed. Don't put a password or a certificate here —
# the notarization password lives only in the keychain profile.

# The codesign identity. Its full name: security find-identity -v -p codesigning
SIGN_IDENTITY="Developer ID Application: Talha Turhan (AL9CGWVTYB)"

TEAM_ID="AL9CGWVTYB"

# The keychain profile created with xcrun notarytool store-credentials.
NOTARY_PROFILE="WHISPER_NOTARY"

# The gh release create target: <user>/<repo>
GH_REPO="tallhigh/whisper-mac-app"
