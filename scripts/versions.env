# Pinned third-party versions. An upgrade must be a deliberate commit: after changing
# one, run `make bootstrap` plus the acceptance-test round in docs/PLAN.md.
# Last verified: 2026-10-01

UV_VERSION=0.12.21
# Sparkle supplies the update framework (through SPM) and the signing tools (vendored).
# Sparkle publishes no sibling .sha256, so the digest is pinned here instead: a release an
# attacker could replace would carry a checksum file they could replace too.
SPARKLE_VERSION=2.10.0
SPARKLE_SHA256=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c
PYTHON_VERSION=3.13
